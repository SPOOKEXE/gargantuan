#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D SourceTexture;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D OutputTexture;

layout(set = 2, binding = 0) uniform Builtin { vec4 Resolution; vec4 Time; } builtin;
layout(set = 2, binding = 1) uniform Params { vec4 Levels; } params;

const float BAYER[16] = float[16](
        0.0, 8.0, 2.0, 10.0,
        12.0, 4.0, 14.0, 6.0,
        3.0, 11.0, 1.0, 9.0,
        15.0, 7.0, 13.0, 5.0
    );

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(builtin.Resolution.xy);
    if (c.x >= size.x || c.y >= size.y) return;

    vec4 source = imageLoad(SourceTexture, c);
    float threshold = (BAYER[(c.y % 4) * 4 + (c.x % 4)] + 0.5) / 16.0;

    float levels = max(params.Levels.x, 2.0);
    vec3 nudged = source.rgb + (threshold - 0.5) / (levels - 1.0);
    vec3 quantised = floor(clamp(nudged, 0.0, 1.0) * (levels - 1.0) + 0.5) / (levels - 1.0);

    imageStore(OutputTexture, c, vec4(quantised, source.a));
}
