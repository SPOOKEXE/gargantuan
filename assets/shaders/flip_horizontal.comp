#version 450

// Preset: mirrors the image left to right.
//
//   local flip = Instance.new("ComputeShader")
//   flip.Source = "flip_horizontal"
//   camera:AddShader(flip)
//
// Takes no parameters.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D SourceTexture;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D OutputTexture;

layout(set = 2, binding = 0) uniform Builtin {
    vec4 Resolution;
    vec4 Time;
} builtin;

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(builtin.Resolution.xy);

    if (coordinate.x >= size.x || coordinate.y >= size.y) {
        return;
    }

    ivec2 mirrored = ivec2(size.x - 1 - coordinate.x, coordinate.y);
    imageStore(OutputTexture, coordinate, imageLoad(SourceTexture, mirrored));
}
