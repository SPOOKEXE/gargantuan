#version 450

// Preset: false-colour heat map, brightness standing in for temperature.
//   shader:SetNumber("Contrast", 1.4)

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D SourceTexture;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D OutputTexture;

layout(set = 2, binding = 0) uniform Builtin { vec4 Resolution; vec4 Time; } builtin;
layout(set = 2, binding = 1) uniform Params { vec4 Contrast; } params;

// black -> indigo -> red -> orange -> yellow -> white
vec3 Heat(float t) {
    t = clamp(t, 0.0, 1.0);
    if (t < 0.25) return mix(vec3(0.0, 0.0, 0.10), vec3(0.35, 0.0, 0.55), t / 0.25);
    if (t < 0.50) return mix(vec3(0.35, 0.0, 0.55), vec3(0.90, 0.10, 0.10), (t - 0.25) / 0.25);
    if (t < 0.75) return mix(vec3(0.90, 0.10, 0.10), vec3(1.0, 0.65, 0.0), (t - 0.50) / 0.25);
    return mix(vec3(1.0, 0.65, 0.0), vec3(1.0, 1.0, 0.92), (t - 0.75) / 0.25);
}

void main() {
    ivec2 coordinate = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(builtin.Resolution.xy);
    if (coordinate.x >= size.x || coordinate.y >= size.y) return;

    vec4 source = imageLoad(SourceTexture, coordinate);
    float luma = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));
    luma = clamp((luma - 0.5) * max(params.Contrast.x, 0.0001) + 0.5, 0.0, 1.0);

    imageStore(OutputTexture, coordinate, vec4(Heat(luma), source.a));
}
